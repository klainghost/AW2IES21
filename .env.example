PORT=3000

# MongoDB local (Compass: mongodb://localhost:27017). Para Atlas: mongodb+srv://usuario:pass@cluster.xxxx.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=astroturismo

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiame_por_un_secret_largo_y_aleatorio
JWT_EXPIRES_IN=24h
