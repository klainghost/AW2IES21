---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Excursiones">
    <section class="mb-6 flex flex-col gap-1">
        <h1 class="text-2xl font-extrabold md:text-3xl">Excursiones</h1>
        <p class="text-niebla">Elegí tus experiencias bajo el cielo de Malargüe.</p>
    </section>

    <div id="listaExcursiones" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        <p class="text-niebla">Cargando excursiones...</p>
    </div>

    <script>
        import { getExcursiones } from '../scripts/api/excursiones.js'
        import { renderExcursiones, escucharAgregar } from '../scripts/components/listaExcursiones.js'

        const contenedor = document.getElementById('listaExcursiones')
        let excursiones = []

        escucharAgregar(contenedor, () => excursiones)

        const cargarExcursiones = async () => {
            try {
                const { ok, data } = await getExcursiones()
                if (!ok) throw new Error(data)

                excursiones = data
                renderExcursiones(contenedor, excursiones)
            } catch (error) {
                console.error(error)
                contenedor.innerHTML = '<p class="text-atardecer">No se pudieron cargar las excursiones.</p>'
            }
        }

        document.addEventListener('DOMContentLoaded', cargarExcursiones)
    </script>
</Layout>
